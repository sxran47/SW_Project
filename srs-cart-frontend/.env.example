VITE_API_BASE_URL=http://localhost:3000
# Mocking works only in Vite development. Set false to use your backend.
VITE_ENABLE_MOCKS=true
# Payment gateway controls and reset endpoint require mode=test AND this flag.
VITE_ENABLE_TEST_CONTROLS=false
# Deterministic development scenarios: normal | slow | error | empty
VITE_MOCK_SCENARIO=normal
